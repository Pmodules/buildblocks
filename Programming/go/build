#!/usr/bin/env modbuild

pbuild::configure() {
  :
}

pbuild::compile() {
  export GOROOT_FINAL="${PREFIX}"
  export GOROOT_BOOTSTRAP="$(go env GOROOT)"

  export GOMAXPROCS=8

  cd "${SRC_DIR}/src"
  ./make.bash
}

pbuild::install() {
  cd "${SRC_DIR}"

  rsync -a \
    --exclude='pkg/obj/*' \
    --exclude='.git/' \
    ./ "${PREFIX}/"
}
