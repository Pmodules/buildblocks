#!/usr/bin/env modbuild

pbuild::configure() {
	:
}

pbuild::compile() {
	:
}

pbuild::install() {
	tar xpfz "$BUILDBLOCK_DIR/nvhpc_2026_265_Linux_$(uname -m)_cuda_multi.tar.gz" -C "$SRC_DIR" --strip-components=1

	export NVHPC_SILENT="true"
	export NVHPC_INSTALL_DIR=$PREFIX
	export NVHPC_INSTALL_TYPE="network"
	$SRC_DIR/install
}
