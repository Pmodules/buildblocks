#!/usr/bin/env modbuild

pbuild::prep() {
    # Create bin/ in the installation directory
    mkdir -p $PREFIX/bin/

    # Copy executable script to the installation directory
    cp -n "$BUILDBLOCK_DIR/rfd4-generate" "$PREFIX/bin/"

    # Add execute permission to the script
    chmod +x "$PREFIX/bin/rfd4-generate"
}

pbuild::configure() {
    :
}

pbuild::compile() {
    :
}

pbuild::install() {
    :
}
