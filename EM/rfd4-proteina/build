#!/usr/bin/env modbuild

pbuild::prep() {
    # Create bin/ in the installation directory
    mkdir -p "$PREFIX/bin"

    # Copy all RFD4 executable scripts
    cp -n "$BUILDBLOCK_DIR"/bin/rfd4-* "$PREFIX/bin/"

    # Add execute permissions
    chmod +x "$PREFIX"/bin/rfd4-*
}

pbuild::configure() {
    :
}

pbuild::compile() {
    :
}

pbuild::install() {
    :
}
