#!/usr/bin/env modbuild

pbuild::pre_configure() {
    echo "> Setting system flags"

    export CFLAGS='-march=native'
    export CXXFLAGS='-march=native'
    export FFLAGS='-march=native'

    PLUMED_LIB="${PLUMED_PREFIX}/lib"
    export PKG_CONFIG_PATH="${PLUMED_LIB}/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"
    export LDFLAGS="-L${PLUMED_LIB} -Wl,-rpath-link,${PLUMED_LIB} -Wl,-rpath,${PLUMED_LIB}${LDFLAGS:+ ${LDFLAGS}}"
    export LD_LIBRARY_PATH="${PLUMED_LIB}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
}
