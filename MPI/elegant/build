#!/usr/bin/env modbuild

export LC_ALL=C

export HOST_ARCH=linux-x86_64
export EPICS_HOST_ARCH=linux-x86_64
export RPN_DEFNS=${PREFIX}/.defns.rpn

pbuild::pre_prep() {
	mkdir -p "${PREFIX}/epics"
}

pbuild::unpack(){
        local -- fname="$1"
        local -- dir="$2"
        local -r strip="${3:-1}"
        local -- unpacker="${4:-tar}"

        fname=$(envsubst <<<"${fname}")
        if [[ -z "${dir}" ]]; then
                dir="${SRC_DIR}"
        else
                dir=$(envsubst <<<"${dir}")
        fi
        unpacker=$(envsubst <<<"${unpacker}")
        mkdir -p "${dir}"

        case "${unpacker}" in
                tar )
                        tar \
                                --directory="${dir}" \
                                -xv \
                                --strip-components "${strip}" \
                                -f "${fname}"
                        ;;
                none )
                        cp "${fname}" "${dir}"
                        ;;
                * )
                        pbcore::err_invalid_unpacker "${unpacker}"
                        ;;
        esac
}
        
# We need to source an extra file containing extra configurations
source ${BUILDBLOCK_DIR}/files/config/elegant-${V_PKG}.source

pbuild::post_prep() {

        ln -sf ${PREFIX}/.defns.rpn ${PREFIX}/defns.rpn

	cd "${PREFIX}/epics"
	ln -fs base-* base
        git clone https://github.com/epics-extensions/extensions

        curl --location --fail \
             --output ${PREFIX}/SDDS-${ELEGANT_SDDS_VERSION}.tar.gz \
             https://ops.aps.anl.gov/downloads/SDDS.${ELEGANT_SDDS_VERSION}.tar.gz
        curl --location --fail \
             --output ${PREFIX}/SDDSepics.${ELEGANT_SDDS_EPICS_VERSION}.tar.gz \
             https://ops.aps.anl.gov/downloads/SDDSepics.${ELEGANT_SDDS_EPICS_VERSION}.tar.gz
        curl --location --fail \
             --output ${PREFIX}/oag.apps.configure.tar.gz \
             https://ops.aps.anl.gov/downloads/oag.apps.configure.tar.gz
        curl --location --fail \
             --output ${PREFIX}/oag.${ELEGANT_OAG_VERSION}.tar.gz \
             https://ops.aps.anl.gov/downloads/oag.${ELEGANT_OAG_VERSION}.tar.gz
        curl --location --fail \
             --output ${PREFIX}/elegant-${V_PKG}.tar.gz \
             https://ops.aps.anl.gov/downloads/elegant.${V_PKG}.tar.gz

        pbuild::unpack "${PREFIX}/SDDS-${ELEGANT_SDDS_VERSION}.tar.gz" "${PREFIX}" "0" "tar"
        pbuild::unpack "${PREFIX}/SDDSepics.${ELEGANT_SDDS_EPICS_VERSION}.tar.gz" "${PREFIX}" "0" "tar"
        pbuild::unpack "${PREFIX}/oag.apps.configure.tar.gz" "${PREFIX}" "0" "tar"
        pbuild::unpack "${PREFIX}/oag.${ELEGANT_OAG_VERSION}.tar.gz" "${PREFIX}" "0" "tar"
        pbuild::unpack "${PREFIX}/elegant-${V_PKG}.tar.gz" "${PREFIX}" "0" "tar"

        # Apply patches recursively built for the ${V_PKG} release.
        # This was mainly useful for older Elegant releases.
        cd "${BUILDBLOCK_DIR}"
	for patch_file in "files/patch/${V_PKG}"/*.patch; do
	    [[ -f "$patch_file" ]] || continue
	    patch -d "${PREFIX}" -p0 --batch --forward < "$patch_file" || exit 1
	done
}

pbuild::configure() {
	local -- dir="${PREFIX}/epics/base/configure"
	echo "SHARED_LIBRARIES=NO" >> "${dir}/CONFIG"
	echo "LINKER_USE_RPATH=NO" >> "${dir}/CONFIG"
	echo "COMMANDLINE_LIBRARY=" >> "${dir}/CONFIG"
}

pbuild::compile() {
	# This should be fixed in the module, C_INCLUDE_PATH is wrong in OpenBLAS
	C_INCLUDE_PATH+=:"${OPENBLAS_INCLUDE_DIR}/openblas"

	# Required for HDF5 support
	C_INCLUDE_PATH+=:"${PREFIX}/epics/extensions/src/SDDS/hdf5/src"
	C_INCLUDE_PATH+=:"${PREFIX}/epics/extensions/src/SDDS/hdf5/src/H5FDsubfiling"

	CPLUS_INCLUDE_PATH=$C_INCLUDE_PATH

	export C_INCLUDE_PATH
	export CPLUS_INCLUDE_PATH

	make -C "${PREFIX}/epics/base" -j 5 || exit 42

	make -C "${PREFIX}/epics/extensions/configure" clean all || exit 42

	make -C "${PREFIX}/epics/extensions/src/SDDS" clean
	make -C "${PREFIX}/epics/extensions/src/SDDS" -j || true
	make -C "${PREFIX}/epics/extensions/src/SDDS" -j || true
	make -C "${PREFIX}/epics/extensions/src/SDDS"    || exit 42

        # Necessary for having qtDriver support
	make -C "${PREFIX}/epics/extensions/src/SDDS/SDDSaps" || exit 42
	make -C "${PREFIX}/epics/extensions/src/SDDS/SDDSaps/sddsplots" || exit 42
	make -C "${PREFIX}/epics/extensions/src/SDDS/SDDSaps/sddsplots/qtDriver" || exit 42

	make -C "${PREFIX}/epics/extensions/src/oagca" clean
	make -C "${PREFIX}/epics/extensions/src/oagca" -j || exit 42

	make -C "${PREFIX}/epics/extensions/src/SDDSepics" clean
	make -C "${PREFIX}/epics/extensions/src/SDDSepics" -j || exit 42

	echo "EPICS_BASE=${PREFIX}/epics/base" >> ${PREFIX}/oag/apps/configure/RELEASE
	echo "EPICS_EXTENSIONS=${PREFIX}/epics/extensions" >> ${PREFIX}/oag/apps/configure/RELEASE
	make -C "${PREFIX}/oag/apps/configure" clean all || exit 42

	make -C "${PREFIX}/oag/apps/src/tcltklib" clean all || exit 42

	make -C "${PREFIX}/oag/apps/src/tcltkapp/oagapp" clean all || exit 42

        # Needed to get oagtclsh compiled
        make -C "${PREFIX}/oag/apps/src/tcltkinterp/extensions/sdds" -j 8 || exit 42

	make -C "${PREFIX}/oag/apps/src/elegant" clean || exit 42
	make -C "${PREFIX}/oag/apps/src/elegant" -j || exit 42

	# build the parallel version of Elegant
	make -C "${PREFIX}/epics/extensions/src/SDDS/SDDSlib" clean
	make -C "${PREFIX}/epics/extensions/src/SDDS/SDDSlib" -e -j \
		F77="${F77} -m64 -ffixed-line-length-132" \
		MPI_CC="${MPICC}" \
		MPI_CCC="${MPICXX}" \
		"${ELEGANT_CUSTOM_EXTRA_PARAMS}" || exit 42

	make -C "${PREFIX}/oag/apps/src/elegant" clean
	make -C "${PREFIX}/oag/apps/src/elegant" -e -j \
		F77="${F77} -m64 -ffixed-line-length-132" \
		MPI_CC="${MPICC}" \
		MPI_CCC="${MPICXX}" \
		${ELEGANT_CUSTOM_EXTRA_PARAMS:-} || exit 42
}
pbuild::install() {
        # Needed to get oagtclsh installed
	local oag_apps="${PREFIX}/oag/apps"
	local sdds_ext="${oag_apps}/src/tcltkinterp/extensions/sdds"
	local pkg_dir="${oag_apps}/lib/${HOST_ARCH}/sdds"
	local bin_dir="${oag_apps}/bin/${HOST_ARCH}"
	local tclsh_bin
	
	tclsh_bin="$(command -v tclsh8.6)" || {
	    printf '%s\n' 'Tcl 8.6 is required to install oagtclsh' >&2
	    exit 42
	}
	
	install -d "$pkg_dir" "$bin_dir" || exit 42
	install -m 644 \
	    "$sdds_ext/pkgIndex.tcl" \
	    "$sdds_ext/O.${HOST_ARCH}/libtclSDDS.so" \
	    "$pkg_dir/" || exit 42
	ln -sfnT "$tclsh_bin" "$bin_dir/oagtclsh" || exit 42
}

# Local Variables:
# mode: sh
# sh-basic-offset: 8
# tab-width: 8
# End:
