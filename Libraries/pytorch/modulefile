#%Module1.0

module-whatis       "libtorch is the C++ API for PyTorch"
module-url          "https://docs.pytorch.org/cppdocs/"
module-license      "https://github.com/pytorch/pytorch/blob/main/LICENSE"
module-maintainer   "João Pedro Agostinho de Sousa <joao.agostinho-de-sousa@psi.ch>"
module-help "
LibTorch is the C++ distribution of PyTorch that allows developers to build,
train, and deploy machine-learning and deep-learning models directly in C++
applications. It provides core PyTorch features such as tensors, neural-network
modules, automatic differentiation, CPU/GPU acceleration, and model inference,
making it particularly useful for integrating AI models into
performance-sensitive applications without requiring a Python runtime.
"

prepend-path PATH \
    "${PREFIX}/miniforge/envs/${P}_${V_PKG}/bin"

prepend-path LD_LIBRARY_PATH \
    "${PREFIX}/miniforge/envs/${P}_${V_PKG}/lib/[lindex [split "${V}" "-"] end]/site-packages/torch/lib"

setenv TORCH_ROOT \
    "${PREFIX}/miniforge/envs/${P}_${V_PKG}/lib/[lindex [split "${V}" "-"] end]/site-packages/torch"

setenv TORCH_LIB \
    "${PREFIX}/miniforge/envs/${P}_${V_PKG}/lib/[lindex [split "${V}" "-"] end]/site-packages/torch/lib"

setenv TORCH_INCLUDE \
    "${PREFIX}/miniforge/envs/${P}_${V_PKG}/lib/[lindex [split "${V}" "-"] end]/site-packages/torch/include"
