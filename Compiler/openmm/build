#!/usr/bin/env modbuild

pbuild::pre_configure() {
    # Install Miniforge
    mkdir -p "$PREFIX/miniforge"
    wget "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-$(uname)-$(uname -m).sh" -O "$PREFIX/miniforge/miniforge.sh"
    bash "$PREFIX/miniforge/miniforge.sh" -b -u -p "$PREFIX/miniforge/"

    # Initialize mamba for script use
    source "$PREFIX/miniforge/etc/profile.d/mamba.sh"

    # Define the environment path
    ENV_PATH="$PREFIX/miniforge/envs/${P}_${V_PKG}"

    # Create the Conda environment at the specified path
    mamba create -y --prefix "$ENV_PATH" "python=${PYTHON_VERSION}"

    # Activate the conda environment
    IFS="${IFS:-$' \t\n'}"
    export IFS

    set +u
    mamba activate "${P}_${V_PKG}"
    set -u

    export CONDA_MKL_INTERFACE_LAYER_BACKUP="${CONDA_MKL_INTERFACE_LAYER_BACKUP:-}"
    mamba install -y cython swig doxygen numpy setuptools pdoc openmm-torch 
}
