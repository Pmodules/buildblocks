#!/usr/bin/env modbuild

pbuild::pre_configure() {
    # Replace $install_bin_dir and $install_library_dir in configure to install
    # VMD in the correct directory
    sed -i "s|^[$]install_bin_dir=.*$|\$install_bin_dir=\"$PREFIX/bin\";|" "${SRC_DIR}/configure"
    sed -i "s|^[$]install_library_dir=.*$|\$install_library_dir=\"$PREFIX/lib/\$install_name\";|" "${SRC_DIR}/configure"
}

pbuild::configure() {

    cd ${SRC_DIR}

    # Set plugins directory
    export PLUGINDIR=${SRC_DIR}/plugins

    if [ "$(uname -m)" = "x86_64" ]; then
        ./configure LINUXAMD64
    else
        echo "Unsupported architecture"
        exit 1
    fi
}

pbuild::compile() {
    :
}

pbuild::install() {
    cd ${SRC_DIR}/src
    make install
}
